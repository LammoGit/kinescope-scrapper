{{template "head" .}}

<section class="page-header">
  <div>
    <h1>Jobs</h1>
    <p class="muted">All tasks handled by the coordinator</p>
  </div>
  <a href="/jobs/create" class="btn btn-primary">+ New job</a>
</section>

<section class="card">
  <table class="table" id="jobs-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Range</th>
        <th>Status</th>
        <th>Progress</th>
        <th>Found</th>
        <th>Downloaded</th>
        <th>Errors</th>
        <th>Workers</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="jobs-tbody">
      <tr><td colspan="9" class="muted">Loading…</td></tr>
    </tbody>
  </table>
</section>

<script src="/static/js/jobs.js" defer></script>
{{template "foot" .}}
